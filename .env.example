# Upstox API V3 Configuration
UPSTOX_API_KEY=YOUR_UPSTOX_CLIENT_ID
UPSTOX_API_SECRET=YOUR_UPSTOX_CLIENT_SECRET
UPSTOX_ACCESS_TOKEN=YOUR_NEW_ACCESS_TOKEN
UPSTOX_REDIRECT_URI=YOUR_REGISTERED_REDIRECT_URI

# Application Mode: DEMO or LIVE (Default: DEMO with labeled synthetic data)
APP_MODE=DEMO

# Database Configuration (PostgreSQL in production, SQLite in local development)
DATABASE_URL=sqlite:///./option_chain.db

# Cache & Streaming Broker
REDIS_URL=redis://localhost:6379/0

# Official NSE F&O Universe Source URL
NSE_FO_SOURCE_URL=https://archives.nseindia.com/content/fo/fo_mktlots.csv
