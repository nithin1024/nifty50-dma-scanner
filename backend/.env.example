# Application Configuration
APP_NAME="NIFTY 50 DMA Scanner"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration (Neon PostgreSQL pooled connection string in production)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/nifty50_dma?sslmode=require
NEON_DATABASE_URL=

# Upstox API Credentials (Level 8)
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
UPSTOX_ACCESS_TOKEN=""
UPSTOX_REDIRECT_URI="http://localhost:8000/api/v1/auth/upstox/callback"
UPSTOX_MAX_FULL_COMBINED_SUBSCRIPTIONS=1500
UPSTOX_MAX_COMBINED_SUBSCRIPTIONS=2000

# Market Data Polling / Freshness Settings
DATA_FRESHNESS_THRESHOLD_SECONDS=60
