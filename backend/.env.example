# Application Configuration
APP_NAME="NIFTY 50 DMA Scanner"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration (PostgreSQL for future levels)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nifty50_dma

# Upstox API Credentials (Level 8)
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
UPSTOX_REDIRECT_URI="http://localhost:8000/api/v1/auth/upstox/callback"

# Market Data Polling / Freshness Settings
DATA_FRESHNESS_THRESHOLD_SECONDS=60
